---
// Dumbbell / dot plot: one row per category, one dot per survey year on a shared scale.
// Static SVG rendered at build time; hover a dot for its value (native <title> tooltip,
// with a hit target larger than the mark). A table view is always available.
interface Props {
  caption: string;
  rows: { label: string; values: { year: number; value: number }[] }[];
  min: number;
  max: number;
  ticks: { at: number; label: string }[];
  colors: Record<number, string>;
}
const { caption, rows, min, max, ticks, colors } = Astro.props;
const years = [...new Set(rows.flatMap((r) => r.values.map((v) => v.year)))].sort();

const W = 680, labelW = 200, padR = 24, rowH = 40, top = 12, axisH = 34;
const plotW = W - labelW - padR;
const H = top + rows.length * rowH + axisH;
const x = (v: number) => labelW + ((v - min) / (max - min)) * plotW;
const fmt = (v: number) => v.toFixed(1);
---
<figure class="dotplot">
  <figcaption>{caption}</figcaption>
  <ul class="legend" aria-label="Survey year">
    {years.map((y) => <li><span class="swatch" style={`background:${colors[y]}`}></span>{y}</li>)}
  </ul>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption}>
    {ticks.map((t) => (
      <g>
        <line x1={x(t.at)} x2={x(t.at)} y1={top - 4} y2={top + rows.length * rowH} class="grid" />
        <text x={x(t.at)} y={H - 10} text-anchor="middle" class="tick">{t.label}</text>
      </g>
    ))}
    {rows.map((r, i) => {
      const cy = top + i * rowH + rowH / 2;
      const xs = r.values.map((v) => x(v.value));
      return (
        <g class="row">
          <text x={labelW - 14} y={cy + 5} text-anchor="end" class="label">{r.label}</text>
          <line x1={Math.min(...xs)} x2={Math.max(...xs)} y1={cy} y2={cy} class="link" />
          {r.values.map((v) => (
            <g class="pt">
              <circle cx={x(v.value)} cy={cy} r="7" fill={colors[v.year]} stroke="#fff" stroke-width="2" />
              <circle cx={x(v.value)} cy={cy} r="14" class="hit">
                <title>{`${r.label} · ${v.year}: ${fmt(v.value)}`}</title>
              </circle>
            </g>
          ))}
        </g>
      );
    })}
  </svg>
  <details>
    <summary>Show as a table</summary>
    <table>
      <thead><tr><th scope="col">Category</th>{years.map((y) => <th scope="col">{y}</th>)}</tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {years.map((y) => {
              const v = r.values.find((p) => p.year === y);
              return <td>{v ? fmt(v.value) : '—'}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .dotplot { margin: 0; }
  figcaption { font-weight: 650; font-size: 1.05rem; margin-bottom: 6px; }
  .legend { list-style: none; display: flex; gap: 18px; padding: 0; margin: 0 0 8px; font-size: 0.88rem; color: var(--ink-2); }
  .legend li { display: inline-flex; align-items: center; gap: 7px; }
  .swatch { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .tick { font-size: 14px; fill: var(--ink-3); }
  .label { font-size: 16.5px; fill: var(--ink); }
  .link { stroke: #c7d0da; stroke-width: 2; stroke-linecap: round; }
  .hit { fill: transparent; cursor: default; }
  .pt:hover circle:first-child { r: 9; }
  details { margin-top: 10px; font-size: 0.9rem; }
  summary { cursor: pointer; color: var(--accent); }
  table { border-collapse: collapse; margin-top: 10px; width: 100%; max-width: 480px; }
  th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); font-weight: 400; }
  thead th { font-weight: 650; }
  td { font-variant-numeric: tabular-nums; }
</style>
