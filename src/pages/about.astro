---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, url } from '../site.config';
import peter from '../assets/about/peter.jpg';
import peterElizabeth from '../assets/about/peter-elizabeth.jpg';
---
<Base title="About" description="Mako Real Estate is Peter Sedivec's owner-operated rental business in Southern California and Bend, Oregon.">
  <section class="section">
    <div class="container about">
      <div>
        <div class="eyebrow">About</div>
        <h1>A landlord who picks up the phone</h1>
        <p class="lede">
          {SITE.brand} is {SITE.owner}'s owner-operated rental business. We own every home we rent,
          in Southern California and Central Oregon, and manage them ourselves.
        </p>
        <p>
          We've been buying, improving, and caring for rental homes for about twenty years. We keep
          the portfolio small on purpose: it means every tenant has a direct line to the owner, issues
          get decisions quickly, and homes get the long-term investment that a quick-flip
          landlord would skip.
        </p>
        <p>
          Since 2024 we've run an annual tenant survey and shared the results — the good and the
          things to fix — with every household. You can read the{' '}
          <a href={url('tenant-survey-results/')}>results here</a>.
        </p>
        <p>
          Peter and Elizabeth met in 2007, weeks after Peter bought his first property in Long Beach. In
          2008 Elizabeth moved in with Peter. Together they've moved many times, bouncing around Southern
          California, eventually migrating to Bend, Oregon, and living abroad in Abu Dhabi and England.
          They have fond memories of all their homes, and each of their three children was born in a
          different one. You can learn more about their journey on Elizabeth's website,{' '}
          <a href="https://kindredcourage.com" target="_blank" rel="noopener">kindredcourage.com</a>.
        </p>
        <p class="muted">
          {SITE.owner} is a licensed California real estate professional (DRE #{SITE.dre}).
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={url('contact/')}>Get in touch</a>
        </div>
      </div>
      <div class="photos">
        <figure>
          <Image src={peter} alt={SITE.owner} widths={[250, 500]} sizes="250px" />
          <figcaption><a href={SITE.linkedin} target="_blank" rel="noopener">{SITE.owner}</a></figcaption>
        </figure>
        <figure>
          <Image src={peterElizabeth} alt={`Elizabeth and ${SITE.owner}`} widths={[250, 500]} sizes="250px" />
          <figcaption class="muted">Elizabeth and Peter</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1fr) 246px; gap: 56px; align-items: start; }
  .photos { display: grid; gap: 24px; }
  figure { margin: 0; }
  figure img { width: 100%; height: auto; border-radius: 14px; display: block; }
  figcaption { font-size: 0.88rem; margin-top: 8px; }
  @media (max-width: 860px) {
    .about { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .photos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 60%; }
  }
</style>
