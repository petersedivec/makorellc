---
import Base from '../layouts/Base.astro';
---
<Base title="Tenant Survey Results" description="Results of Mako RE's annual tenant satisfaction survey, 2024–2026.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Annual tenant survey</div>
      <h1>What our tenants say</h1>
      <p class="lede">
        Every spring since 2024 we've asked every household how we're doing. Here's what they told us —
        and what we changed because of it.
      </p>
      <p class="muted">Charts and year-by-year results coming next.</p>
    </div>
  </section>
</Base>
