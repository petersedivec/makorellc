---
import Base from '../layouts/Base.astro';
import { url } from '../site.config';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="container">
      <div class="eyebrow">404</div>
      <h1>That page isn't here</h1>
      <p class="lede">It may have moved. Try one of these instead:</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url()}>Home</a>
        <a class="btn btn-ghost" href={url('homes/')}>Our homes</a>
        <a class="btn btn-ghost" href={url('contact/')}>Contact</a>
      </div>
    </div>
  </section>
</Base>
