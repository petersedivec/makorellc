---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../site.config';

export async function getStaticPaths() {
  const homes = await getCollection('homes');
  return homes.map((home) => ({ params: { id: home.id }, props: { home } }));
}

interface Props { home: CollectionEntry<'homes'> }
const { home } = Astro.props;
const d = home.data;
const { Content } = await render(home);
const photos = [d.hero, ...d.gallery].filter((p) => p !== undefined);
const inquire = url(`contact/?home=${home.id}`);
---
<Base title={`${d.title} · ${d.city}`} description={`${d.type} in ${d.city}, ${d.state}, owned and managed by Mako RE.`}>
  <section class="section">
    <div class="container">
      <a href={url('homes/')} class="back">← All properties</a>
      <div class="eyebrow">{d.city}, {d.state}</div>
      <h1>{d.title}</h1>
      <p class="facts">
        <span>{d.type}</span>
        {d.beds && <span>{d.beds} bd</span>}
        {d.baths && <span>{d.baths} ba</span>}
        {d.units.length > 0 && <span>{d.units.length} units</span>}
        <span class={d.status === 'available' ? 'badge badge-available' : 'badge'}>{d.status}</span>
      </p>

      {photos.length > 0 ? (
        <div class="photos">
          {photos.map((p, i) => (
            <a class="zoom" href={p.src}>
              <Image src={p} alt={`${d.title}, photo ${i + 1}`} widths={[480, 960, 1440]} sizes="(max-width: 800px) 100vw, 560px" />
            </a>
          ))}
        </div>
      ) : (
        <div class="photo-placeholder">Photos coming soon</div>
      )}

      <div class="body"><Content /></div>

      {d.units.length > 0 && (
        <div class="units">
          <h2>Units</h2>
          {d.units.map((u) => (
            <div class="unit card">
              <div class="card-body unit-head">
                <h3>{u.name}</h3>
                <span class="muted">{u.beds} bd · {u.baths} ba</span>
                <span class={u.status === 'available' ? 'badge badge-available' : 'badge'}>{u.status}</span>
                {u.zillowUrl && <a href={u.zillowUrl} target="_blank" rel="noopener">View on Zillow →</a>}
              </div>
              {u.description && (
                <div class="unit-desc">
                  {u.description.trim().split(/\n\s*\n/).map((para) => <p>{para}</p>)}
                </div>
              )}
              {u.photos.length > 0 && (
                <div class="unit-photos">
                  {u.photos.map((p, i) => (
                    <a class="zoom" href={p.src}>
                      <Image src={p} alt={`${u.name}, photo ${i + 1}`} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 360px" />
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      <div class="btn-row">
        <a class="btn btn-primary" href={inquire}>Inquire about this home</a>
        {d.zillowUrl && <a class="btn btn-ghost" href={d.zillowUrl} target="_blank" rel="noopener">View listing on Zillow</a>}
      </div>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img alt="" />
    <button class="lb-btn lb-close" aria-label="Close">×</button>
    <button class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
    <button class="lb-btn lb-next" aria-label="Next photo">›</button>
  </dialog>
</Base>

<script>
  // Full-size photo viewer. Each thumbnail is a link to the full image, so it still works without JS.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a.zoom')];
  const box = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = box.querySelector('img')!;
  let at = 0;

  function show(i: number) {
    at = (i + links.length) % links.length;
    img.src = links[at].href;
    img.alt = links[at].querySelector('img')?.alt ?? '';
  }

  links.forEach((a, i) => a.addEventListener('click', (e) => {
    e.preventDefault();
    show(i);
    box.showModal();
  }));
  box.querySelector('.lb-close')!.addEventListener('click', () => box.close());
  box.querySelector('.lb-prev')!.addEventListener('click', () => show(at - 1));
  box.querySelector('.lb-next')!.addEventListener('click', () => show(at + 1));
  box.addEventListener('click', (e) => { if (e.target === box) box.close(); }); // backdrop
  box.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(at - 1);
    if (e.key === 'ArrowRight') show(at + 1);
  });
</script>

<style>
  .back { display: inline-block; margin-bottom: 18px; text-decoration: none; font-size: 0.92rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; color: var(--ink-2); }
  .photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin: 28px 0; }
  .photos :global(img), .unit-photos :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; }
  .photo-placeholder {
    margin: 28px 0; aspect-ratio: 21 / 8; display: grid; place-items: center; border-radius: var(--radius);
    background: linear-gradient(135deg, var(--accent-soft), #fff); color: var(--accent); font-weight: 600;
  }
  .body { max-width: 46rem; }
  .units { margin-top: 40px; display: grid; gap: 20px; }
  .unit-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .unit-head h3 { margin: 0; }
  .unit-desc { padding: 0 22px 6px; max-width: 46rem; color: var(--ink-2); }
  .unit-desc p { margin: 0 0 12px; }
  .unit-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; padding: 0 22px 22px; }
  .zoom { display: block; cursor: zoom-in; border-radius: 10px; }
  .zoom:hover :global(img) { opacity: 0.92; }

  .lightbox {
    width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: transparent; display: none; place-items: center;
  }
  .lightbox[open] { display: grid; }
  .lightbox::backdrop { background: rgba(10, 14, 20, 0.9); }
  .lightbox img { max-width: 94vw; max-height: 90vh; object-fit: contain; border-radius: 6px; }
  .lb-btn {
    position: fixed; border: 0; border-radius: 999px; width: 48px; height: 48px; cursor: pointer;
    background: rgba(255, 255, 255, 0.15); color: #fff; font-size: 2rem; line-height: 1;
  }
  .lb-btn:hover { background: rgba(255, 255, 255, 0.3); }
  .lb-close { top: 16px; right: 16px; }
  .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
</style>
