---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HomeCard from '../../components/HomeCard.astro';

const homes = (await getCollection('homes')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { label: 'Southern California', homes: homes.filter((h) => h.data.market === 'socal') },
  { label: 'Central Oregon', homes: homes.filter((h) => h.data.market === 'bend') },
];
---
<Base title="Our Properties" description="The rental properties Mako Real Estate owns and manages in Southern California and Bend, Oregon.">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Our properties</div>
      <h1>Properties we own and care for</h1>
      <p class="lede">
        Every property here is owned and managed by us directly — no property-management middleman.
        Homes marked <span class="badge badge-available">Available</span> are currently listed for rent.
      </p>
      {groups.map((g) => (
        <div class="group">
          <h2>{g.label}</h2>
          <div class="grid grid-3">{g.homes.map((home) => <HomeCard home={home} />)}</div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .group { margin-top: 48px; }
  /* Two per row: SoCal's four homes fill two even rows instead of three plus one. */
  .group .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 720px) { .group .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
